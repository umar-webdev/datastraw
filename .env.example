# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase: Connect -> Session pooler connection string (port 5432). URL-encode special chars in the password.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Test secret from the assessment brief
WEBHOOK_SECRET=verdant-demo-secret-2026

# Any long random string, e.g. `bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
JWT_SECRET=change-me-to-a-long-random-string

# Any OpenAI-compatible /chat/completions endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-api-key
LLM_MODEL=gemini-3.1-flash-lite

# Seeded agent account for signing in to the Agent view
SEED_AGENT_EMAIL=agent@verdant.test
SEED_AGENT_PASSWORD=change-me-please
