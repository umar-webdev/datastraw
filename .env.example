# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase: Connect -> Session pooler connection string (port 5432). URL-encode special chars in the password.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Test secret from the assessment brief
WEBHOOK_SECRET=verdant-demo-secret-2026

# Any long random string, e.g. `bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
JWT_SECRET=change-me-to-a-long-random-string

# Any OpenAI-compatible /chat/completions endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-api-key
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_MS=20000

# Optional: a second model for the retry when the first call fails (free tiers get overloaded).
# URL and key default to the primary's. Example with Groq (free key at console.groq.com):
#   LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
#   LLM_FALLBACK_API_KEY=your-groq-key
#   LLM_FALLBACK_MODEL=<a current Groq model id>
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Seeded agent account for signing in to the Agent view
SEED_AGENT_EMAIL=agent@verdant.test
SEED_AGENT_PASSWORD=change-me-please
